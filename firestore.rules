rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.superAdmin == true;
    }

    function isWorkerInZone(workerId, zoneId) {
      return zoneId in get(/databases/$(database)/documents/workers/$(workerId)).data.allowedZones;
    }

    // Additive permission-scopes rollout (docs/SPEC_DECISIONS.md): defined
    // and available, but not yet required by any existing rule below —
    // isAdmin() alone remains sufficient everywhere it already was. Use
    // hasScope() only in NEW rules until a deliberate follow-up decision
    // starts tightening existing ones.
    function hasScope(scope) {
      return isAdmin() && scope in
        get(/databases/$(database)/documents/admin_permissions/$(request.auth.uid)).data.scopes;
    }

    // Gate 0 fix (legal state transitions): the worker- and customer-driven
    // slices of the booking lifecycle that a plain client Firestore write is
    // allowed to perform. Assignment itself (pending -> confirmed) is
    // deliberately NOT here — that only ever happens server-side, inside the
    // acceptJob Cloud Function transaction (functions/src/index.ts), which
    // uses the Admin SDK and so bypasses these rules entirely. This function
    // only fences in what an authenticated client can do directly.
    function isLegalWorkerBookingTransition(from, to) {
      return (from == 'confirmed' && to == 'workerAssigned') ||
             (from == 'workerAssigned' && to == 'workerEnRoute') ||
             (from == 'workerEnRoute' && to == 'workerArrived') ||
             (from == 'workerArrived' && to == 'inProgress') ||
             (from == 'inProgress' && to == 'completed') ||
             (from == to);
    }

    // =========================================================================
    // USERS (Base Auth Records)
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Gate 0 fix (role escalation, CRITICAL): this rule previously allowed
      // an unrestricted self-write. Combined with manualBackup/
      // restoreFromBackup/getSystemHealth (functions/src/backup.ts,
      // health.ts) trusting this document's `role` field instead of a
      // Firebase Auth custom claim, any signed-in user could set
      // role: 'admin' on their own doc and then successfully call those
      // admin-only Cloud Functions — including restoreFromBackup, which can
      // overwrite production data. Those functions now check
      // request.auth.token.admin/superAdmin instead, but this rule is
      // hardened in depth too: `role` can never be client-written at all,
      // and `userType` may only ever be self-set to a non-privileged value.
      allow create, update: if isAuthenticated() && request.auth.uid == userId
        && !('role' in request.resource.data)
        && (!('userType' in request.resource.data)
            || request.resource.data.userType in ['customer', 'worker', 'unknown']);

      // Device/session list (FR-AUTH-007) — purely metadata about the
      // owner's own devices, so a normal self-write is sufficient; the
      // actual security boundary (killing a refresh token) is enforced by
      // Firebase Auth itself via the revokeOtherSessions Cloud Function.
      match /sessions/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // =========================================================================
    // CUSTOMER PROFILES (PDPA — self-access only)
    // =========================================================================
    match /customer_profiles/{profileId} {
      // Customers access their own profile (document keyed by userId field, not profileId)
      allow read:   if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // WORKERS (PDPA Critical)
    // =========================================================================
    match /workers/{workerId} {
      // Workers read/write their own profile
      allow read: if isAuthenticated() && request.auth.uid == workerId;

      // Workers CANNOT self-promote their verification status or tier.
      // Gate 0 fix (provider self-approval): `verificationTier` was not
      // previously guarded here, only `isVerified` — a worker could raise
      // their own tier (e.g. to unlock higher-risk categories) even though
      // isVerified itself was already correctly frozen.
      allow create: if isAuthenticated() && request.auth.uid == workerId;
      allow update: if isAuthenticated() && request.auth.uid == workerId
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.get('verificationTier', null) == resource.data.get('verificationTier', null);

      // Private subcollection (bank details, passport) — extra protection
      match /private_data/{doc} {
        allow read, write: if isAuthenticated() && request.auth.uid == workerId;
      }
    }

    match /worker_documents/{workerId} {
      // Only the worker or an admin can access KYC documents
      allow read, write: if isAuthenticated() && request.auth.uid == workerId;
    }

    match /worker_applications/{workerId} {
      allow create: if isAuthenticated() && request.auth.uid == workerId;

      // Gate 0 fix (provider self-approval, CRITICAL): this rule previously
      // let a worker update ANY field on their own application, including
      // `status` — meaning a worker could set status: 'approved' on
      // themselves directly, with no admin ever involved. Applicants may
      // still freely edit their own submitted application content; only the
      // review-decision fields are now admin/Cloud-Function-only.
      allow update: if isAuthenticated() && request.auth.uid == workerId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['status', 'rejectionReason', 'reviewedBy', 'reviewedAt', 'approvedAt']);

      allow read: if isAuthenticated() && request.auth.uid == workerId;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // WORKER PUBLIC PROFILES (Gate 0 addition — location privacy)
    // =========================================================================
    //
    // The `workers` document above is owner+admin-only, which is correct for
    // its NIC/home-address/home-coordinate fields — but it means there was
    // no rule anywhere granting a customer read access to a provider's
    // profile at all. ProviderProfileScreen (which reads `workers` directly
    // today) is therefore denied under the rules as actually deployed. This
    // collection is the fix: a Cloud-Function-maintained mirror containing
    // only the fields that are safe for any authenticated user to see
    // (name, photo, rating, bio, services, district-level area, tier) —
    // never NIC, exact address, or home/live coordinates. It is written only
    // by the syncWorkerPublicProfile trigger (functions/src/index.ts, Admin
    // SDK), never directly by a client.
    match /worker_public_profiles/{workerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =========================================================================
    // BOOKINGS (canonical operational model used by the Flutter app)
    // =========================================================================
    match /bookings/{bookingId} {
      // Customers create their own bookings. Gate 0 fix: a booking must
      // start in 'pending' with no worker pre-assigned — previously this
      // rule only checked ownership, so a client could create a booking
      // that was already 'confirmed' with an arbitrary workerId, skipping
      // the offer/acceptance process entirely and self-assigning any
      // worker. Real assignment only ever happens server-side (see
      // acceptJob in functions/src/index.ts), which uses the Admin SDK and
      // so is unaffected by this restriction.
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('workerId', null) == null;

      // Customers read their own bookings; assigned workers read theirs
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid
      );

      // Workers update status/timestamps on jobs assigned to them.
      //
      // NOTE: this must use diff().affectedKeys(), not keys(). request.resource.data
      // is the FULL document after the write (existing fields merged with the
      // update), so keys().hasOnly([...]) would require every field the booking
      // has ever had — customerId, serviceType, price, etc. — to be in the
      // allowlist, which blocks every update including legitimate ones. Verified
      // empirically against the Firestore emulator: the previous keys()-based
      // rule rejected a worker's plain status update with permission-denied.
      //
      // Gate 0 fix (legal state transitions): added
      // isLegalWorkerBookingTransition() so a worker can only move their own
      // booking one legal step forward (e.g. cannot jump straight from
      // 'confirmed' to 'completed'), not set status to an arbitrary value.
      allow update: if isAuthenticated()
        && resource.data.workerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'startedAt', 'completedAt', 'arrivedAt',
            'actualArrivalLocation', 'checkIn', 'checkOut', 'billableHours'
          ])
        && isLegalWorkerBookingTransition(resource.data.status, request.resource.data.status);

      // Customers cancel their own bookings
      allow update: if isAuthenticated()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancellationReason', 'cancelledAt', 'updatedAt'
          ]);

    }

    // =========================================================================
    // JOBS (State Machine + Zone Enforcement)
    // =========================================================================
    match /jobs/{jobId} {
      // Customers can read their own jobs; assigned workers can read theirs
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid ||
         resource.data.assignedWorkerId == request.auth.uid);

      // Any authenticated user can create (customer books a job)
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid;

      // Workers can only update jobs explicitly assigned to them, and only
      // the state-machine fields (see Job entity) — not price, customerId, etc.
      allow update: if isAuthenticated() &&
        resource.data.assignedWorkerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acceptedAt', 'startedAt', 'completedAt'
        ]);
    }

    // =========================================================================
    // LIVE JOB LOCATIONS (Privacy-Critical — PDPA Minimization)
    // Only accessible during an active job. Auto-cleared after completion.
    // =========================================================================
    match /job_locations/{jobId} {
      // Reads: customer or assigned worker during active job only
      allow read: if isAuthenticated() &&
        (get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId == request.auth.uid ||
         get(/databases/$(database)/documents/jobs/$(jobId)).data.assignedWorkerId == request.auth.uid);

      // Writes: only assigned worker during active status phases
      allow write: if isAuthenticated() &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.assignedWorkerId == request.auth.uid &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.status in ['enRoute', 'arrived', 'inProgress'];
    }

    // =========================================================================
    // AUDIT LOGS (Immutable — write-once for labor dispute protection)
    // =========================================================================
    match /audit_logs/{logId} {
      // Gate 0 fix (audit-log permissions, HIGH): this rule previously let
      // ANY authenticated user create an audit_logs entry, not just admins —
      // meaning a malicious customer or worker could permanently pollute the
      // immutable audit trail with fabricated entries. Every real write site
      // found in the app (review_repository_impl.dart, admin_dispute_screen.dart,
      // admin_review_moderation_screen.dart) is an admin-initiated action and
      // already stamps `adminUserId`, so requiring both isAdmin() and actor
      // self-attribution here does not break any legitimate current caller.
      allow create: if isAdmin() && request.resource.data.adminUserId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false; // Immutable — no updates or deletions ever
    }

    // =========================================================================
    // ADMIN PERMISSIONS (granular scopes — additive, see hasScope() above)
    // =========================================================================
    match /admin_permissions/{adminUid} {
      allow read: if isAuthenticated() && request.auth.uid == adminUid;
      allow read: if isAdmin();
      // No client write, ever — even for super admin. Granting/revoking a
      // scope requires two-person approval (pending_approvals below); only
      // the applyApprovedChange Cloud Function (Admin SDK, bypasses rules)
      // writes here.
      allow write: if false;
    }

    // =========================================================================
    // PENDING APPROVALS (two-person approval for high-risk admin changes)
    // =========================================================================
    match /pending_approvals/{approvalId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.proposedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      // Only a DIFFERENT admin than the proposer may decide, only while
      // still pending, and only status/decision fields may change — the
      // actual change (e.g. deactivating a category) is applied server-side
      // by a Cloud Function once status becomes 'approved', never by this
      // write directly.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && resource.data.proposedBy != request.auth.uid
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt', 'reason']);

      allow delete: if false;
    }

    // =========================================================================
    // CONSENT RECORDS (Terms/Privacy acceptance — immutable, versioned)
    // =========================================================================
    match /consent_records/{recordId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false; // Immutable — a new version gets a new record
    }

    // =========================================================================
    // CHAT MESSAGES (PDPA Data Retention — 30-day TTL via GCP policy)
    // =========================================================================
    match /messages/{messageId} {
      // Enforce createdAt on every document to support Cloud Firestore TTL policy
      allow create: if isAuthenticated() && request.resource.data.createdAt != null;
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
    }

    // =========================================================================
    // ADMIN OVERRIDE (Custom Claim)
    // =========================================================================
    //
    // This blanket rule ORs with every other match block in this file — a
    // more specific `allow write: if false` elsewhere does NOT override it,
    // Firestore has no "more specific wins" precedence between sibling
    // match blocks. Verified empirically against the emulator: the specific
    // `admin_permissions` and `pending_approvals` rules below were being
    // silently bypassed by this catch-all until the exclusion was added,
    // which would have made the two-person-approval mechanism decorative —
    // any single admin could still write either collection directly.
    //
    // Gate 0 fix: `audit_logs` had exactly this same bug and was caught by
    // this branch's own emulator tests — the specific audit_logs rule above
    // (isAdmin() + actor-must-match-self, immutable) was being silently
    // overridden by this catch-all, since audit_logs was missing from the
    // exclusion list below. Any admin could still forge another admin as
    // the actor, or edit/delete an existing log entry, straight through
    // this blanket grant.
    match /{document=**} {
      allow read, write: if isAdmin()
        && !(request.path[3] in [
              'admin_permissions', 'pending_approvals', 'service_catalog', 'audit_logs'
            ]);
    }

    // Job matching specific rules (mirrors bookings collection for Cloud Function dispatch)
match /job_requests/{jobId} {
  // Customers can create jobs
  allow create: if request.auth != null 
    && request.resource.data.customerId == request.auth.uid
    && request.resource.data.status == 'searching';
    
  // Workers can update status when assigned to them
  allow update: if request.auth != null 
    && resource.data.assignedWorkerId == request.auth.uid
    && request.resource.data.keys().hasOnly(['status', 'arrivedAt', 'startedAt', 'completedAt', 'actualArrivalLocation']);
    
  // Both can read if involved
  allow read: if request.auth != null 
    && (resource.data.customerId == request.auth.uid 
        || resource.data.assignedWorkerId == request.auth.uid);
}

match /job_offers/{offerId} {
  // Workers can only read their own offers
  allow read: if request.auth != null
    && resource.data.workerId == request.auth.uid;

  // Gate 0 fix (authenticated worker acceptance, CRITICAL): a worker could
  // previously set their own offer's status directly to 'accepted' via a
  // plain client write, completely bypassing the acceptJob Cloud Function's
  // atomic transaction (functions/src/index.ts) — meaning two workers could
  // each accept the same offer with no cross-worker atomicity check at all,
  // and neither acceptance would ever be reflected on the bookings document.
  // 'accepted' is now only ever set server-side, inside that transaction,
  // using the Admin SDK (which bypasses this rule entirely). A client may
  // still directly decline an offer — that path has no atomicity concern.
  allow update: if request.auth != null
    && resource.data.workerId == request.auth.uid
    && request.resource.data.status == 'rejected';
}

match /worker_locations/{workerId} {
  // Workers write their own location
  allow write: if request.auth != null && request.auth.uid == workerId;

  // Gate 0 fix (location privacy, HIGH): this rule previously let ANY
  // signed-in user read ANY online worker's precise live coordinates just
  // by knowing (or guessing) their uid — a real, exploitable location
  // exposure with no relationship to the requester required at all. The
  // broader client-side proximity-discovery code that this clause existed
  // to support (lib/features/matching/data/services/location_tracking_service.dart's
  // geohash range query, lib/features/matching/domain/usecases/find_nearest_worker.dart)
  // has no caller anywhere in the app today — verified by grep — so this
  // tightening does not remove any currently-reachable capability. A
  // worker's location is now only visible to themselves, an admin, or the
  // customer of the booking that worker is actively assigned to (via the
  // currentBookingId field the worker's app sets when it starts sending
  // location updates for a specific job).
  allow read: if request.auth != null && (
    request.auth.uid == workerId ||
    isAdmin() ||
    ('currentBookingId' in resource.data && resource.data.currentBookingId != null &&
     get(/databases/$(database)/documents/bookings/$(resource.data.currentBookingId)).data.customerId == request.auth.uid)
  );
}

    // =========================================================================
    // REVIEWS (Moderation pipeline)
    // =========================================================================
    match /reviews/{reviewId} {
      // Customers submit reviews for completed bookings they own
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.moderationStatus == 'pending';

      // Customers read their own reviews; anyone can read approved reviews
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.moderationStatus == 'approved'
      );

      // Only admins moderate (approve/hide/flag)
      allow update: if isAdmin()
        && request.resource.data.keys().hasAny([
            'moderationStatus', 'adminNote', 'moderatedAt'
          ]);

      allow delete: if false;
    }

    // =========================================================================
    // DISPUTES (Trust & Safety)
    // =========================================================================
    match /disputes/{disputeId} {
      // Parties involved in the booking can create a dispute
      allow create: if isAuthenticated()
        && request.resource.data.reportedByUserId == request.auth.uid;

      // Disputants can read their own dispute
      allow read: if isAuthenticated() && (
        resource.data.reportedByUserId == request.auth.uid ||
        resource.data.reportedUserId == request.auth.uid
      );

      // Only admins can update dispute status
      allow update: if isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // SERVICE CATALOG (Read-public; write-admin)
    // =========================================================================
    match /service_catalog/{categoryId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // A lone admin may create/edit a category and may reactivate one, but
      // deactivating (isActive: true -> false) requires two-person approval
      // — see pending_approvals. Only applyApprovedChange (Admin SDK)
      // actually flips it to false once approved.
      allow update: if isAdmin() &&
        !(resource.data.get('isActive', true) == true &&
          request.resource.data.isActive == false);
    }

    match /wallets/{walletId} {
      // Read-only for the owner. Every legitimate balance mutation goes
      // through server-side Cloud Functions (holdWalletFunds,
      // releaseWalletFunds, payhereNotify, processRefund,
      // completeReferralOnBooking) using the Admin SDK, which bypasses these
      // rules entirely — so the client never needs write access here, and
      // granting it only lets a user set their own balance directly.
      allow read: if isAuthenticated() && request.auth.uid == walletId;
      allow read, write: if isAdmin();
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      // Customers create their own pending payment record right after
      // generating a checkout URL (see PaymentRepositoryImpl.processPayment).
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || isAdmin()
      );
      // Status transitions ('completed', 'refunded', etc.) are only ever
      // legitimate via the payhereNotify webhook, which validates PayHere's
      // signature server-side and writes with the Admin SDK (bypassing these
      // rules) — a client update here would be a forged status, not a real
      // payment confirmation.
      allow update: if isAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        resource.data.workerId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    match /incidents/{incidentId} {
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        resource.data.subjectId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow create, delete: if isAdmin();
    }

    match /safety_alerts/{alertId} {
      allow create: if isAuthenticated() && (
        request.resource.data.workerId == request.auth.uid ||
        request.resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow read: if isAuthenticated() && (
        resource.data.workerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.workerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if false;
    }

    match /chatRooms/{chatRoomId} {
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt != null;
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.workerId == request.auth.uid ||
          isAdmin()
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.workerId == request.auth.uid ||
          isAdmin()
        );
        allow delete: if false;
      }
    }

    // =========================================================================
    // ADMIN OVERRIDE — Super Admin only for audit log reads (extra guard)
    // =========================================================================

    // =========================================================================
    // SUPPORT TICKETS
    // =========================================================================
    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;

      allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid;

      // Admins respond and update status
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
            'adminResponse', 'respondedBy', 'status', 'updatedAt'
          ]);
    }

    // =========================================================================
    // USER FEEDBACK SYSTEM (Sprint 3)
    // =========================================================================
    match /feedback/{feedbackId} {
      // Users can create feedback (they submit it)
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.isResolved == false;
        
      // Users can read their own feedback; Admins can read all
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      
      // Only admins can update (for marking as resolved and responding)
      allow update: if isAdmin() 
        && request.resource.data.keys().hasOnly(['isResolved', 'adminResponse', 'updatedAt']);
        
      // No one can delete feedback (audit trail)
      allow delete: if false;
    }

  }
}
